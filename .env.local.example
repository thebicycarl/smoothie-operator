# Google Apps Script web app deployment URL that appends rows to your sheet.
# See README.md for setup instructions.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional shared secret. If set, the same value must be checked inside your
# Apps Script doPost handler before appending the row.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Set automatically on Netlify. Used for absolute URLs when needed.
# NEXT_PUBLIC_SITE_URL=https://logicarl.com/smoothieoperator
